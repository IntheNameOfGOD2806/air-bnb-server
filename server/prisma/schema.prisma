datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  createdAt   DateTime   @default(now())
  email       String?    @unique
  firstName   String?
  id          String     @id @default(cuid())
  lastName    String?
  listings    Listing[]
  password    String
  roles       Json
  trips       Trip[]
  updatedAt   DateTime   @updatedAt
  username    String     @unique
  wishlists   Wishlist[]
  userImage   String?
  blogs       Blog[]     @relation("UserBlogs")
  comments    Comment[]  @relation("UserComments")
  cometChatId String?
}

model Listing {
  createdAt          DateTime   @default(now())
  description        String
  id                 String     @id @default(cuid())
  listingCreatedBy   User       @relation(fields: [listingCreatedById], references: [id])
  listingCreatedById String
  locationData       Json
  locationType       String
  mapData            Json
  photos             Json
  placeAmeneties     Json
  placeSpace         Json
  title              String
  placeType          String
  price              Float
  trips              Trip[]
  updatedAt          DateTime   @updatedAt
  wishlists          Wishlist[]
  isTour             Boolean    @default(false)
}

model Wishlist {
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Trip {
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  tripinfo  Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  status    String   @default("pending")
  isTour    Boolean  @default(false)    
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation("UserBlogs", fields: [authorId], references: [id])
  authorId    String
  comments    Comment[] @relation("BlogComments")
  coverImage  String? // Optional thumbnail/cover image
  tags        String[] // List of tags (optional)
  isPublished Boolean   @default(false)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation("BlogComments", fields: [blogId], references: [id])
  blogId    String
  user      User     @relation("UserComments", fields: [userId], references: [id])
  userId    String
  likes     Int      @default(0)
  stars     Int      @default(0)
}

